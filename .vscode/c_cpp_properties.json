{
    "env": {
        "cedev": "${env:HOME}/CEdev"
    },
    "configurations": [
        {
            "name": "TI-84 Plus CE",
            "compilerPath": "${cedev}/bin/ez80-clang",
            "compilerArgs": ["-nostdinc"],
            "intelliSenseMode": "clang-x86",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/src",
                "${cedev}/include",
                "${cedev}/include/c++"
            ],
            "defines": ["__TICE__=1", "NDEBUG=1"]
        }
    ],
    "version": 4
}
